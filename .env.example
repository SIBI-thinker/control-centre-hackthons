# Copy to .env and fill in. Never commit the real .env.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase → Project Settings → API → service_role (secret).
# Server-only: bypasses row-level security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs session cookies. At least 32 characters. Rotating it signs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Web push for issue notifications. Generate once:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Regenerating invalidates every device that enabled notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real contact address - push services may reject placeholder domains.
VAPID_SUBJECT=mailto:you@example.com
